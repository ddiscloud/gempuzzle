{
  "name": "gempuzzle",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test tests/*.test.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gempuzzle-rules \"node --test --test-concurrency=1 tests/firestore/*.test.cjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.29.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
